{
    "name": "nawasara/news",
    "description": "Menarik artikel berita dari situs-situs WordPress Pemkab Ponorogo ke Nawasara, dan menyediakannya lewat API publik tanpa autentikasi untuk aplikasi klien (Android/iOS).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.0",
        "spatie/laravel-permission": "^6.0",
        "nawasara/ui": "^0.1 || dev-main",
        "nawasara/sync": "*"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\News\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\News\\NewsServiceProvider"
            ]
        }
    }
}
